{% extends 'base.html.twig' %}

{% block title %}Anime{% endblock %}

{% block body %}
    <h1>Anime</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ anime.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ anime.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ anime.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ anime.image }}</td>
            </tr>
            <tr>
                <th>Author</th>
                <td>{{ anime.author }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ anime.date ? anime.date|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_anime_index') }}">back to list</a>

    <a href="{{ path('app_anime_edit', {'id': anime.id}) }}">edit</a>

    {{ include('anime/_delete_form.html.twig') }}
{% endblock %}
