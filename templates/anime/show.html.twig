{% extends 'base.html.twig' %}

{% block title %}AnimeView{% endblock %}

{% block body %}
    <div class="crud-container">
        <h1 class="crud-title">Détails de l'anime</h1>

        <table class="crud-table show-table">
            <tbody>
            <tr>
                <th>Id</th>
                <td>{{ anime.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ anime.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ anime.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td><img src="{{ asset(anime.image) }}" alt="{{ anime.name }}" class="table-img"></td>
            </tr>
            <tr>
                <th>Auteur</th>
                <td>{{ anime.author }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ anime.date ? anime.date|date('Y-m-d') : '' }}</td>
            </tr>
            </tbody>
        </table>

        <div class="crud-actions-inline">
            <a href="{{ path('app_anime_index') }}" class="crud-link">Retour à la liste</a>
            <a href="{{ path('app_anime_edit', {'id': anime.id}) }}" class="action-link edit">Modifier</a>
            {{ include('anime/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
