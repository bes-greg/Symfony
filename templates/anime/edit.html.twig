{% extends 'base.html.twig' %}

{% block title %}Modifier l'anime{% endblock %}

{% block body %}
    <div class="loginFormDiv" style="flex-direction: column; gap: 20px; padding: 40px 0;">
        <h1 class="loginFormTitle">Modifier l'anime</h1>

        {{ include('anime/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

        <div style="display: flex; gap: 20px; align-items: center;">
            <a href="{{ path('app_anime_index') }}" style="color: #eee; text-decoration: none; font-weight: 600;">Retour à la liste</a>
            {{ include('anime/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
