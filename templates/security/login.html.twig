{% extends 'base.html.twig' %}

{% block title %}AnimeView{% endblock %}

{% block body %}
    <div class="loginFormDiv">
        <form class="loginForm" method="post">
            <h1 class="loginFormTitle">Se connecter</h1>
            <div class="loginFormLabelInput">
                <label class="loginFormLabel" for="inputEmail">Email</label>
                <input class="loginFormInput" type="email" value="{{ last_username }}" name="email" id="inputEmail"  autocomplete="email" required autofocus>
            </div>
            <div class="loginFormLabelInput">
                <label class="loginFormLabel" for="inputPassword">Mot de passe</label>
                <input class="loginFormInput" type="password" name="password" id="inputPassword" autocomplete="current-password" required>
            </div>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <label>
                <input  type="checkbox" name="_remember_me"> Se souvenir de moi
            </label>

            <button class="loginFormBtn" type="submit">
                Se connecter
            </button>
        </form>
    </div>

{% endblock %}
